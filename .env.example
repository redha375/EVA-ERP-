# Copy to .env for local development only. Never commit .env.
# In EAS builds, set these as EAS environment variables instead:
#   eas env:create --environment production --name EXPO_PUBLIC_API_BASE_URL --value https://api.example.com --visibility plaintext

# ---------------------------------------------------------------
# Client (Expo) — embedded in the app bundle, so they are PUBLIC.
# ---------------------------------------------------------------
# Public HTTPS base URL of the deployed API server (no trailing slash).
# Required for any native build; the build fails in production if missing or not https.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=

# Optional: bundle identifier for store publication (defaults to the current identifier in app.config.ts).
# If you set this, set NATIVE_OAUTH_SCHEME on the server to the resulting scheme (manus<timestamp>).
APP_BUNDLE_ID=

# ---------------------------------------------------------------
# API server (Node) — SECRETS. Only on the server, never in the app.
# ---------------------------------------------------------------
NODE_ENV=production
PORT=3000

# MySQL connection string, e.g. mysql://user:password@host:3306/ctp_smart
DATABASE_URL=

# Manus project ID and OAuth endpoints (same values as the client, server side).
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=

# Secret used to sign session tokens. Use a long random value (>= 32 bytes).
MANUS_JWT_SECRET=

# openId of the first platform administrator. Sign in once, read your openId in the users table,
# then set it here. This account can then assign ERP roles to everyone else.
OWNER_OPEN_ID=

# Must equal the app's deep-link scheme: manus<timestamp> derived from the bundle ID.
# Default for the current identifier: manus251309797782513
NATIVE_OAUTH_SCHEME=manus251309797782513

# Exact origins of the Expo web preview. Leave empty for a native-only setup.
EXPO_PACKAGER_PROXY_URL=
EXPO_WEB_PREVIEW_URL=
